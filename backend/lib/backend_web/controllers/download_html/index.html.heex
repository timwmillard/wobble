<div class="min-h-screen bg-[#161820] text-slate-100 antialiased">
  <div class="h-1.5 w-full bg-[linear-gradient(90deg,#EF130B,#FF7100,#FFC800,#00CC00,#00B2FF,#7A3CE0)]">
  </div>

  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-20">
    <%!-- Hero --%>
    <header class="flex flex-col items-center text-center">
      <img src={~p"/images/wobble-icon.svg"} alt="" class="size-28 drop-shadow-2xl sm:size-32" />
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-5xl">
        Download
        <span class="bg-[linear-gradient(90deg,#FF7100,#FFC800,#00CC00,#00B2FF,#7A3CE0)] bg-clip-text text-transparent">
          Wobble
        </span>
      </h1>
      <p class="mt-4 max-w-xl text-lg text-slate-400">
        The desktop app for the drawing-and-guessing party game. It plays in the
        same rooms as the browser, so friends can join from either.
      </p>
      <a
        href={@play_url}
        class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-sky-400 hover:text-sky-300"
      >
        Or play in your browser now <span aria-hidden="true">&rarr;</span>
      </a>
    </header>

    <%!-- Platforms --%>
    <section id="platforms" class="mt-14 grid gap-4 sm:grid-cols-3">
      <div
        :for={p <- @platforms}
        id={"platform-#{p.id}"}
        class={[
          "relative flex flex-col rounded-2xl border p-6",
          p.files != [] && "border-white/10 bg-[#262A33]",
          p.files == [] && "border-dashed border-white/10 bg-transparent",
          p.id == @detected && p.files != [] && "ring-2 ring-[#FFC800]/70"
        ]}
      >
        <span
          :if={p.id == @detected && p.files != []}
          class="absolute -top-3 left-6 rounded-full bg-[#FFC800] px-2.5 py-0.5 text-xs font-bold text-[#161820]"
        >
          Your system
        </span>
        <div class={["flex items-center gap-3", p.files == [] && "text-slate-500"]}>
          <.platform_logo id={p.id} class="size-7" />
          <h2 class="text-xl font-bold">{p.name}</h2>
        </div>
        <p class={["mt-2 text-sm", (p.files == [] && "text-slate-600") || "text-slate-400"]}>
          {p.detail}
        </p>

        <div class="mt-6 flex flex-1 flex-col justify-end gap-2">
          <%= if p.files == [] do %>
            <span class="rounded-xl border border-white/5 px-4 py-2.5 text-center text-sm font-semibold text-slate-500">
              Coming soon
            </span>
            <p class="text-center text-xs text-slate-600">
              You can
              <a href="#build" class="underline hover:text-slate-400">build it from source</a>
              today.
            </p>
          <% else %>
            <a
              :for={f <- p.files}
              href={f.url}
              class={[
                "rounded-xl px-4 py-2.5 text-center text-sm font-semibold transition",
                f.primary &&
                  "bg-[#FF7100] text-white shadow-lg shadow-[#FF7100]/20 hover:bg-[#ff8526]",
                !f.primary && "text-slate-300 hover:bg-white/5"
              ]}
            >
              <.icon
                :if={f.primary}
                name="hero-arrow-down-tray-mini"
                class="mr-1 size-4 align-[-2px]"
              />
              {f.label}
            </a>
          <% end %>
        </div>
      </div>
    </section>

    <%!-- macOS first launch --%>
    <section id="first-launch" class="mt-6 grid gap-4 sm:grid-cols-2">
      <div
        id="macos-first-launch"
        class="rounded-2xl border border-white/10 bg-[#1E2128] p-6 text-sm leading-6 text-slate-300"
      >
        <h3 class="flex items-center gap-2 font-semibold text-slate-100">
          <.platform_logo id={:macos} class="size-5 text-slate-400" /> Opening it on macOS
        </h3>
        <p class="mt-2">
          Open the <code class="text-slate-100">.dmg</code>
          and drag <b>Wobble</b>
          onto <b>Applications</b>. The app isn't notarized by Apple yet, so the
          first time you open it macOS will refuse. Go to <b>System Settings → Privacy &amp; Security</b>, scroll down and click <b>Open Anyway</b>. Or, in Terminal:
        </p>
        <pre class="mt-3 overflow-x-auto rounded-lg bg-black/40 px-4 py-3 text-[13px] text-slate-200"><code>xattr -dr com.apple.quarantine /Applications/wobble.app</code></pre>
      </div>

      <div
        id="windows-first-launch"
        class="rounded-2xl border border-white/10 bg-[#1E2128] p-6 text-sm leading-6 text-slate-300"
      >
        <h3 class="flex items-center gap-2 font-semibold text-slate-100">
          <.platform_logo id={:windows} class="size-5 text-slate-400" /> Opening it on Windows
        </h3>
        <p class="mt-2">
          Unzip it and run <code class="text-slate-100">wobble.exe</code>. There's
          nothing to install, so put it wherever you like. It isn't code-signed
          yet, so SmartScreen may stop it the first time: click <b>More info</b>, then <b>Run anyway</b>.
        </p>
        <p class="mt-2 text-slate-400">
          It draws with Vulkan, which current graphics drivers from NVIDIA, AMD
          and Intel include. If it won't start, update your graphics driver.
        </p>
      </div>
    </section>

    <%!-- Build from source --%>
    <section id="build" class="mt-20 scroll-mt-8">
      <h2 class="text-3xl font-extrabold tracking-tight">Build from source</h2>
      <p class="mt-3 max-w-2xl text-slate-400">
        Wobble is open source (MIT). The client is plain C11 on
        <a href="https://oscar-soirey.github.io/Raven/" class="text-sky-400 hover:text-sky-300">
          Raven
        </a>
        and builds with a C compiler and CMake 3.15+. Every dependency is vendored
        in the repo, so beyond those (and the X11 headers on Linux) there's
        nothing to install.
      </p>

      <a
        href={@repo_url}
        class="mt-6 inline-flex items-center gap-2.5 rounded-xl border border-white/10 bg-[#262A33] px-4 py-2.5 text-sm font-semibold hover:bg-[#2d323d]"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M12 0C5.37 0 0 5.506 0 12.303c0 5.445 3.435 10.043 8.205 11.674.6.107.825-.262.825-.585 0-.292-.015-1.261-.015-2.291C6 21.67 5.22 20.346 4.98 19.654c-.135-.354-.72-1.446-1.23-1.738-.42-.23-1.02-.8-.015-.815.945-.015 1.62.892 1.845 1.261 1.08 1.86 2.805 1.338 3.495 1.015.105-.8.42-1.338.765-1.645-2.67-.308-5.46-1.37-5.46-6.075 0-1.338.465-2.446 1.23-3.307-.12-.308-.54-1.569.12-3.26 0 0 1.005-.323 3.3 1.26.96-.276 1.98-.415 3-.415s2.04.139 3 .416c2.295-1.6 3.3-1.261 3.3-1.261.66 1.691.24 2.952.12 3.26.765.861 1.23 1.953 1.23 3.307 0 4.721-2.805 5.767-5.475 6.075.435.384.81 1.122.81 2.276 0 1.645-.015 2.968-.015 3.383 0 .323.225.707.825.585a12.047 12.047 0 0 0 5.919-4.489A12.536 12.536 0 0 0 24 12.304C24 5.505 18.63 0 12 0Z"
          />
        </svg>
        {String.replace(@repo_url, "https://", "")}
      </a>

      <ol class="mt-10 space-y-8">
        <li class="flex gap-4">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-[#FF7100] text-sm font-bold">
            1
          </span>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold">Install a compiler, CMake and git</h3>
            <div class="mt-3 space-y-3">
              <.os_commands os={:macos} lines={["xcode-select --install", "brew install cmake"]}>
                or CMake from
                <a href="https://cmake.org/download/" class="text-sky-400 hover:text-sky-300">cmake.org</a>
              </.os_commands>
              <.os_commands
                os={:windows}
                lines={[
                  "winget install Git.Git Kitware.CMake",
                  "winget install Microsoft.VisualStudio.2022.BuildTools --override `",
                  "  \"--add Microsoft.VisualStudio.Workload.VCTools --includeRecommended --passive\""
                ]}
              >
                Visual Studio Build Tools with the C++ workload
              </.os_commands>
              <.os_commands
                os={:linux}
                lines={[
                  "sudo apt install build-essential cmake git libx11-dev   # Debian, Ubuntu",
                  "sudo dnf install gcc cmake git libX11-devel             # Fedora"
                ]}
              >
                plus the X11 headers
              </.os_commands>
            </div>
          </div>
        </li>

        <li class="flex gap-4">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-[#FFC800] text-sm font-bold text-[#161820]">
            2
          </span>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold">Get the source</h3>
            <pre class="mt-3 overflow-x-auto rounded-lg bg-black/40 px-4 py-3 text-[13px] text-slate-200"><code>git clone {@repo_url}.git
cd wobble/client</code></pre>
            <p class="mt-2 text-sm text-slate-400">
              Or grab a
              <a
                href={"#{@repo_url}/archive/refs/heads/main.zip"}
                class="text-sky-400 hover:text-sky-300"
              >
                .zip of the source
              </a>
              without git.
            </p>
          </div>
        </li>

        <li class="flex gap-4">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-[#00CC00] text-sm font-bold text-[#161820]">
            3
          </span>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold">Build and play</h3>
            <p class="mt-1 text-sm text-slate-400">
              The same on every platform (in PowerShell on Windows), from the <code>client</code>
              folder. Setting <code>WOBBLE_SERVER</code>
              makes room codes join games on this server.
            </p>
            <pre class="mt-3 overflow-x-auto rounded-lg bg-black/40 px-4 py-3 text-[13px] text-slate-200"><code>cmake -B build -DCMAKE_BUILD_TYPE=Release -DWOBBLE_SERVER=wss://wobblegame.fly.dev
cmake --build build --config Release</code></pre>
            <p class="mt-4 text-sm text-slate-400">Then run it:</p>
            <div class="mt-2 grid gap-3 sm:grid-cols-3">
              <.os_commands os={:macos} lines={["open build/wobble.app"]} />
              <.os_commands os={:windows} lines={["build\\Release\\wobble.exe"]} />
              <.os_commands os={:linux} lines={["./build/wobble"]} />
            </div>
          </div>
        </li>

        <li class="flex gap-4">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-[#00B2FF] text-sm font-bold text-[#161820]">
            4
          </span>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold">
              Optional: run your own server
            </h3>
            <p class="mt-1 text-sm text-slate-400">
              The server is Elixir and Phoenix and lives in <code>backend</code>. Install
              <a
                href="https://elixir-lang.org/install.html"
                class="text-sky-400 hover:text-sky-300"
              >
                Elixir
              </a>
              (it brings Erlang), then from the repo root:
            </p>
            <pre class="mt-3 overflow-x-auto rounded-lg bg-black/40 px-4 py-3 text-[13px] text-slate-200"><code>cd backend
mix setup
mix phx.server    # listens on localhost:4000</code></pre>
            <p class="mt-3 text-sm text-slate-400">
              A client built without <code>WOBBLE_SERVER</code>
              joins <code>ws://localhost:4000</code>
              by default. Any other build can point at your server with <b>Custom server</b>
              on the connect screen, or <code>--server ws://localhost:4000</code>. Set
              <code>WOBBLE_FAST=1</code>
              for short timers while testing. The
              <a href={"#{@repo_url}#deploying"} class="text-sky-400 hover:text-sky-300">README</a>
              covers deploying it.
            </p>
          </div>
        </li>
      </ol>
    </section>
  </main>

  <footer class="border-t border-white/5 py-8 text-center text-xs text-slate-600">
    Wobble · MIT licensed · <a href={@repo_url} class="hover:text-slate-400">GitHub</a>
  </footer>
</div>
